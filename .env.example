# Clave secreta de Django (generar una segura en producción)
SECRET_KEY=django-insecure-cambiar-en-produccion-clave-ejemplo-1234567890

# Modo de depuración (True en desarrollo, False en producción)
DEBUG=True

# URL de conexión a la base de datos (si no se define, usa SQLite: sqlite:///db.sqlite3)
# Ejemplo PostgreSQL: postgres://blog_user:blog_password@localhost:5432/blog_db
DATABASE_URL=sqlite:///db.sqlite3

# Hosts permitidos separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Orígenes de confianza para CSRF separados por coma (incluir esquema http:// o https://)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# URL pública base del sitio (para enlaces absolutos en correos de suscripción y reportes)
SITE_URL=http://localhost:8000

# Configuración de correo electrónico (por defecto imprime en consola en desarrollo)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@blogpanelautor.local

# Umbrales configurables para insignias y ranking de autores
AUTOR_INSIGNIA_NUEVO_MAX_POSTS=3
AUTOR_INSIGNIA_ACTIVO_MIN_POSTS=5
AUTOR_DESTACADO_TOP_N=4
AUTOR_DESTACADO_UMBRAL_PUNTOS=10

# Credenciales opcionales para acceso social OAuth2 (Google y GitHub)
# Si se dejan vacías, los botones correspondientes no se muestran en la interfaz.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=



